NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/skillora
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Optional SMTP configuration enables email verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SKILLORA <no-reply@skillora.local>
# Optional Cloudinary uploads. Avatar URLs can also be supplied directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
